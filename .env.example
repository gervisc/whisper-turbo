# ── whisper-turbo configuration ─────────────────────────────────────────
# Copy this file to .env and adjust values for your setup.
# Both the proxy and systemd services read from this file.

# ── whisper.cpp server ──────────────────────────────────────────────────

# Where whisper.cpp was cloned and built
WHISPER_CPP_DIR="/opt/whisper.cpp"

# Whisper model filename (must exist in $WHISPER_CPP_DIR/models/)
# Options: ggml-tiny.en.bin, ggml-base.en.bin, ggml-small.en.bin, ggml-medium.en.bin
# Smaller = faster, larger = more accurate. "small.en" is a good balance.
WHISPER_MODEL="ggml-small.en.bin"

# Host and port for the whisper.cpp HTTP server
WHISPER_SERVER_HOST="127.0.0.1"
WHISPER_SERVER_PORT="19003"

# ── whisper-turbo proxy ─────────────────────────────────────────────────

# Host and port for the proxy
PROXY_HOST="127.0.0.1"
PROXY_PORT="19004"

# Folder where uploaded subtitle results are saved
SUBTITLE_OUTPUT_DIR="/opt/whisper-turbo/subtitles"

# ── inference settings ──────────────────────────────────────────────────

# Default language for transcription (override per-request with ?language=xx)
WHISPER_LANGUAGE="en"

# CPU threads for whisper.cpp (rule of thumb: half your CPU cores)
WHISPER_THREADS="4"

# OpenVINO device for the Whisper encoder
# "CPU" — uses OpenVINO CPU optimizations (2-3x faster than raw CPU)
# "GPU" — uses Intel iGPU via OpenCL (faster on 11th gen+ Intel, slower on older)
OPENVINO_DEVICE="CPU"

# ── timeouts ────────────────────────────────────────────────────────────

# Seconds to wait for whisper.cpp server to respond
WHISPER_TIMEOUT="15"

# Seconds to wait for full-movie subtitle inference
WHISPER_SUBTITLE_TIMEOUT="1800"

# Seconds to wait for ffmpeg audio extraction
MEDIA_CONVERT_TIMEOUT="3600"

# ── logging ─────────────────────────────────────────────────────────────

# Log level: debug, info, warning, error
LOG_LEVEL="info"
